<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ModulatorApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ModulatorApp"
    Title="ModulatorApp"
    Shell.NavBarIsVisible="True"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="Black"
    Shell.TitleColor="#FE7F27"
    FlyoutBehavior="Flyout">

    <FlyoutItem Title="Home" Route="home">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Modulators" Route="modulators">
        <ShellContent
            Title="Modulators"
            ContentTemplate="{DataTemplate local:ModulatorsPage}" />
    </FlyoutItem>


</Shell>
