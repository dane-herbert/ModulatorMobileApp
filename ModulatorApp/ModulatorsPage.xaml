<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ModulatorApp.ModulatorsPage"
    Title="Modulators">

    <VerticalStackLayout Padding="16" Spacing="10">

        <Button Text="Kalydeco (ivacaftor)" Clicked="OnModulatorClicked" CommandParameter="Kalydeco"/>
        <Button Text="Orkambi (lumacaftor/ivacaftor)" Clicked="OnModulatorClicked" CommandParameter="Orkambi" />
        <Button Text="Symdeko (tezacaftor/ivacaftor)" Clicked="OnModulatorClicked" CommandParameter="Symbeko"/>
        <Button Text="Trikafta (elexacaftor/tezacaftor/ivacaftor)" Clicked="OnModulatorClicked" CommandParameter="Trikafta"/>
        <Button Text="Alyftrek (vanzacaftor/tezacaftor/deutivacaftor)" Clicked="OnModulatorClicked" CommandParameter="Alyftrek"/>

    </VerticalStackLayout>
</ContentPage>
