<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModulatorApp.MainPage"
             BackgroundColor="White">

    <CollectionView
        ItemsSource="{Binding Cards}"
        SelectionMode="None"
        Margin="0"
        VerticalOptions="FillAndExpand">

        <CollectionView.Header>
            <VerticalStackLayout Padding="30,20" Spacing="18">

                <Image
                    Source="dosehelper.png"
                    HeightRequest="165"
                    Aspect="AspectFit"
                    SemanticProperties.Description="dose buddy character" />

                <Label
                    Text="Modulator Helper"
                    Style="{StaticResource Headline}"
                    SemanticProperties.HeadingLevel="Level1"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="The CFTR Modulator Timer and Reminder Application!"
                    Style="{StaticResource SubHeadline}"
                    SemanticProperties.HeadingLevel="Level2"
                    HorizontalTextAlignment="Center" />

                <Frame
                    Padding="22"
                    CornerRadius="12"
                    BackgroundColor="LightGray"
                    HasShadow="True">

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="Add Modulator"
                            FontSize="22"
                            TextColor="Black"
                            Opacity="0.6"
                            HorizontalTextAlignment="Center" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Button
                                Text="+"
                                FontSize="24"
                                BackgroundColor="#FE7F27"
                                Clicked="OnAddModulatorClicked"
                                Grid.Column="0" />
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame
                    Padding="14"
                    CornerRadius="12"
                    Margin="30,0,30,10"
                    HasShadow="True"
                    BackgroundColor="#F2F2F2">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Medication}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Time1, StringFormat='Dose 1: {0:hh\\:mm}'}" />
                        <Label Text="{Binding Time2, StringFormat='Dose 2: {0:hh\\:mm}', TargetNullValue=''}" />
                    </VerticalStackLayout>

                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
