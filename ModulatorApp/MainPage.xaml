<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ModulatorApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20"
            Spacing="25">
            
            <Image
                Source="dosehelper.png"
                HeightRequest="165"
                Aspect="AspectFit"
                SemanticProperties.Description="dose buddy character" />

            <Label
                Text="Modulator Helper"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="The CFTR Modulator Timer and Reminder Application!"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to the Cystic Fibrosis Modulator Helper Application" />
            
            <VerticalStackLayout
                Padding="0, 25"
                Spacing="25">
                
                <Frame
                    Padding="30"
                    CornerRadius="12"
                    BackgroundColor="LightGray"
                    HasShadow="True">

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="Add Modulator"
                            FontSize="22"
                            TextColor="Black"
                            Opacity="0.6"
                            HorizontalTextAlignment="Center"/>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Button
                                Text="+"
                                FontSize="24"
                                BackgroundColor="#FE7F27"
                                Grid.Column="0" />

                            <!--<Switch
                                Grid.Column="1" />-->
                        </Grid>


                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
